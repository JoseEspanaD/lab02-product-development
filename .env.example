# Copiar a .env y sustituir la contraseña. Nunca versionar .env.
COMPOSE_PROJECT_NAME=lab02
POSTGRES_USER=lab02
POSTGRES_DB=lab02
# Usar una contraseña hexadecimal para construir el DSN sin caracteres reservados.
POSTGRES_PASSWORD=REEMPLAZAR_POR_UN_VALOR_LOCAL
API_PORT=8000
MLFLOW_PORT=5000
DATA_DIR=./data
# Corte simulado fijo, anterior al ejemplo válido del 17/11/2025.
BOOTSTRAP_VALIDATION_END=2025-11-16
# Opcional: commit del código usado; si se omite se conserva el snapshot en el modelo.
SOURCE_REVISION=no-proporcionada
