# Copiar a .env y sustituir la contraseña. Nunca versionar .env.
COMPOSE_PROJECT_NAME=lab02
POSTGRES_USER=lab02
POSTGRES_DB=lab02
# Usar una contraseña hexadecimal para construir el DSN sin caracteres reservados.
POSTGRES_PASSWORD=REEMPLAZAR_POR_UN_VALOR_LOCAL
API_PORT=8000
MLFLOW_PORT=5000
DATA_DIR=./data
# Corte simulado fijo, anterior al ejemplo válido del 17/11/2025.
BOOTSTRAP_VALIDATION_END=2025-11-16
# Opcional: commit del código usado; si se omite se conserva el snapshot en el modelo.
SOURCE_REVISION=no-proporcionada

# Airflow: valores locales distintos a las credenciales del producto.
AIRFLOW_USERNAME=lab02
AIRFLOW_PASSWORD=REEMPLAZAR_POR_OTRO_VALOR_LOCAL
AIRFLOW_DB_PASSWORD=REEMPLAZAR_POR_OTRO_VALOR_LOCAL
AIRFLOW_SECRET_KEY=REEMPLAZAR_POR_HEXADECIMAL_LOCAL
# Generar sin Python local (ver README):
# docker run --rm python:3.14.4-slim-bookworm python -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
AIRFLOW_FERNET_KEY=REEMPLAZAR_POR_CLAVE_FERNET_LOCAL
AIRFLOW_PORT=8080
